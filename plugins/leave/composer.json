{
    "name": "lasabro/leave",
    "description": "Leave policies, statutory minimums, balances and ledger, requests with approval, accrual and year-end jobs, and the leave lookup used by attendance.",
    "type": "lasabro-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Robert MAKUTA",
            "email": "dabani.rm@gmail.com",
            "homepage": "https://dabani.github.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "lasabro/framework": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Lasabro\\Leave\\": "src/",
            "Lasabro\\Leave\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "lasabro": {
            "id": "Lasabro.Leave",
            "title": "Leave",
            "tier": "domain",
            "provider": "Lasabro\\Leave\\LeaveServiceProvider",
            "requires": {
                "Lasabro.Core": "^1.0",
                "Lasabro.Approvals": "^1.0",
                "Lasabro.Rules": "^1.0",
                "Lasabro.Files": "^1.0",
                "Lasabro.Hr": "^1.0",
                "Lasabro.Attendance": "^1.0"
            },
            "suggests": {},
            "frontends": {},
            "declares": [
                "seeders",
                "menu"
            ]
        }
    }
}
